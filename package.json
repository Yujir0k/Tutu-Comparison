{
  "name": "tutu-comparison",
  "private": true,
  "version": "1.0.0",
  "description": "Сравнение реальных предложений транспорта и отелей из Tutu MCP",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c magenta,cyan \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch server/main.ts",
    "dev:web": "vite",
    "build": "pnpm check && pnpm build:client && pnpm build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node .server-dist/server/main.js",
    "check": "tsc --noEmit",
    "lint": "eslint . --cache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test src/*.test.ts server/*.test.ts",
    "quality": "pnpm lint && pnpm check && pnpm test && pnpm build && pnpm format:check"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "prettier": "^3.9.6",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.1.3"
  }
}
